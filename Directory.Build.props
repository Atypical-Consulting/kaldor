<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- One version for the tool, bumped by the release-please PR (see release-please-config.json). -->
    <Version>1.0.0</Version> <!-- x-release-please-version -->

    <Authors>Atypical Consulting</Authors>
    <Company>Atypical Consulting</Company>
    <Copyright>Copyright © 2026 Atypical Consulting</Copyright>
    <PackageProjectUrl>https://github.com/Atypical-Consulting/kaldor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Atypical-Consulting/kaldor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
