{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "kaldor",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "Directory.Build.props" },
        { "type": "json", "path": "plugin/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugin/hooks/hooks.json", "jsonpath": "$.hooks.PreToolUse[0].hooks[0].args[2]" },
        { "type": "generic", "path": "plugin/bin/kaldor" },
        { "type": "generic", "path": "plugin/bin/kaldor.cmd" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Changed" },
        { "type": "revert", "section": "Reverted" },
        { "type": "docs", "section": "Documentation" },
        { "type": "build", "section": "Changed" },
        { "type": "ci", "section": "Changed" },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "style", "section": "Miscellaneous", "hidden": true },
        { "type": "test", "section": "Miscellaneous", "hidden": true }
      ]
    }
  }
}
